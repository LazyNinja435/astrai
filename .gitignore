# https://git-scm.com/docs/gitignore

# Dependencies
node_modules/
/vendor/
.pnpm-store/

# Note: /vendor/ is root-anchored so it does not match .ai/vendor/,
# which holds vendored upstream attribution (e.g. Superpowers LICENSE).

# Build output
dist/
build/
out/
*.tsbuildinfo

# Environment files
.env
.env.*
!.env.example

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# Editor directories
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Temp files
*.tmp
*.temp
tmp/
temp/
.cache/

# Coverage
coverage/
.nyc_output/

# Local-only workspace — never committed.
# sandbox/memory/ holds derived memory views (knowledge.json, KNOWLEDGE.md)
# generated by scripts/memory/fold.ts. Committed memory lives in
# .ai/memory/events/ and .ai/memory/snapshots/.
sandbox/

# Package lock files (keep if desired)
# package-lock.json
# yarn.lock
